<section class="vc-sec vc-sec--cream vc-sec__pad" id="vc-benefits-{{ section.id }}">
  <div class="vc-wrap">
    <div class="vc-sec-head--center vc-fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <span class="vc-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="vc-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="vc-sec-sub">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="vc-bens">
      {%- for block in section.blocks -%}
        <div class="vc-ben vc-fade-up" {{ block.shopify_attributes }}>
          <div class="vc-ben__icon-wrap" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'lightning' -%}
                <svg class="vc-ben__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              {%- when 'brain' -%}
                <svg class="vc-ben__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9.5 2a2.5 2.5 0 0 1 5 0v.25a2.5 2.5 0 0 1 2.5 2.5V5a3 3 0 0 1 3 3v1a3 3 0 0 1-3 3h-.5v6.5a2 2 0 0 1-4 0V12h-1v6.5a2 2 0 0 1-4 0V12H7a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3v-.25A2.5 2.5 0 0 1 9.5 2.25V2Z"/></svg>
              {%- when 'heart' -%}
                <svg class="vc-ben__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {%- when 'moon' -%}
                <svg class="vc-ben__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              {%- when 'shield' -%}
                <svg class="vc-ben__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- when 'leaf' -%}
                <svg class="vc-ben__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 8C8 10 5.9 16.17 3.82 19.34A1 1 0 0 0 4 21c5.39 0 9-3.33 9-3.33V21"/><path d="M21 3C21 3 12 5 8 12"/></svg>
              {%- else -%}
                <svg class="vc-ben__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="vc-ben__title">{{ block.settings.title }}</h3>
          <p class="vc-ben__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div style="text-align:center;margin-top:56px;">
        <a href="{{ section.settings.cta_url }}" class="vc-btn vc-btn--secondary">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>


{% schema %}
{
  "name": "VC Benefits",
  "tag": "section",
  "class": "vc-sec",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Why Cordyceps"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Vitalcep Does for You"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Rooted in ancient wisdom, validated by modern science."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "lightning",
          "options": [
            { "value": "lightning", "label": "Lightning / energy" },
            { "value": "brain",     "label": "Brain / focus" },
            { "value": "heart",     "label": "Heart / vitality" },
            { "value": "moon",      "label": "Moon / sleep" },
            { "value": "shield",    "label": "Shield / immunity" },
            { "value": "leaf",      "label": "Leaf / natural" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Sustained Energy"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Cordyceps militaris supports ATP production — the body's energy currency — for clean, crash-free stamina throughout the day."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VC Benefits",
      "settings": {
        "eyebrow": "Why Cordyceps",
        "heading": "What Vitalcep Does for You",
        "subtext": "Rooted in ancient wisdom, validated by modern science."
      },
      "blocks": [
        { "type": "benefit", "settings": { "icon": "lightning", "title": "Sustained Energy",   "description": "Cordyceps supports ATP production for clean, crash-free stamina throughout the day." } },
        { "type": "benefit", "settings": { "icon": "brain",     "title": "Sharper Focus",      "description": "Adaptogenic compounds help quiet mental fog and support concentration during demanding tasks." } },
        { "type": "benefit", "settings": { "icon": "heart",     "title": "VO₂ Max & Endurance","description": "Clinical studies show Cordyceps militaris can improve oxygen utilisation during exercise." } },
        { "type": "benefit", "settings": { "icon": "shield",    "title": "Immune Resilience",  "description": "Beta-glucans from Cordyceps activate key immune pathways to keep your defences robust." } },
        { "type": "benefit", "settings": { "icon": "moon",      "title": "Stress Adaptation",  "description": "As a true adaptogen, Cordyceps helps modulate the cortisol response to daily stressors." } },
        { "type": "benefit", "settings": { "icon": "leaf",      "title": "100% Natural",       "description": "No synthetic fillers, no proprietary blends. Just pure, batch-tested Cordyceps militaris." } }
      ]
    }
  ]
}
{% endschema %}
