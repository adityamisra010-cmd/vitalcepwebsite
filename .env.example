NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ╔══════════════════════════════════════════════════════════════════════╗
# ║  👉 INSERT YOUR OPENAI API KEY HERE  👈                                ║
# ║  Paste the key after "OPENAI_API_KEY=" below (no quotes, no spaces).   ║
# ║  Leave it blank for now if you're not using AI yet — the app runs      ║
# ║  fine without it; only the AI consolidation/prompt routes need it.     ║
# ╚══════════════════════════════════════════════════════════════════════╝
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SUPABASE_WEBHOOK_SECRET=

# Shared secret for the Vercel Cron job that auto-closes overdue review cycles.
CRON_SECRET=
